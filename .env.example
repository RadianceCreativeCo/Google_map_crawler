# Copy to .env and adjust as needed (compose reads .env automatically)

# Host port for the crawler API
API_PORT=6970

# Host port for the LeadGenUI
UI_PORT=3008

# API URL used by the UI (inlined into the browser JS at BUILD time -> rebuild after changing)
# Option 1 - local, no reverse proxy:
NEXT_PUBLIC_CRAWLER_API_URL=http://localhost:6970
# Option 2 - reverse proxy, same domain (recommended, avoids CORS/mixed content):
# proxy /api/* -> 127.0.0.1:6970 (strip /api prefix), / -> 127.0.0.1:3008
#NEXT_PUBLIC_CRAWLER_API_URL=/api
# Option 3 - separate API domain (CORS is already *):
# proxy https://api.example.com -> 127.0.0.1:6970
#NEXT_PUBLIC_CRAWLER_API_URL=https://api.example.com
